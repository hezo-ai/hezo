{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@hezo/shared": ["../shared/src/index.ts"],
			"@hezo/shared/*": ["../shared/src/*"]
		}
	},
	"include": ["src", "vite-env.d.ts"]
}
