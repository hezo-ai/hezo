{
	"name": "hezo",
	"description": "Your own team of AI agents. Built to deliver.",
	"private": true,
	"license": "GPL-3.0-or-later",
	"packageManager": "bun@1.3.9",
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@playwright/test": "^1",
		"@tanstack/react-query": "^5",
		"@tanstack/react-router": "^1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "3.2.4",
		"commander": "^14.0.3",
		"happy-dom": "^20.9.0",
		"hono": "^4.12.23",
		"husky": "^9.1.7",
		"@types/istanbul-lib-coverage": "^2.0.6",
		"@types/istanbul-lib-report": "^3.0.3",
		"@types/istanbul-reports": "^3.0.4",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"turbo": "^2",
		"typescript": "^5",
		"vitest": "^3"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"build:compile": "bun run scripts/build.ts --compile",
		"build:icons": "bun run --cwd packages/web build:icons",
		"build:release": "bun run scripts/build.ts --release",
		"check": "bunx biome check .",
		"check:fix": "bunx biome check --write .",
		"dev": "bun run scripts/dev.ts",
		"release": "bun run scripts/release.ts",
		"test": "bun run scripts/test.ts",
		"typecheck": "turbo typecheck",
		"prepare": "husky"
	},
	"overrides": {
		"react": "19.2.6",
		"react-dom": "19.2.6"
	}
}
