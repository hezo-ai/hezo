#!/bin/sh
# Wrapper that starts the SSH agent socket bridge before launching the
# headless agent CLI. socat listens on the in-container Unix socket and
# spawns a hezo-ssh-bridge child per connection. When the wrapped command
# exits the trap kills socat so the run leaves no stragglers behind.
#
# Args: <socket_path> <socket_user> <token_hex> <host:port> -- <cmd> [args...]
SOCKET="$1"; shift
SOCK_USER="$1"; shift
TOKEN="$1"; shift
HOST_PORT="$1"; shift
if [ "$1" = "--" ]; then shift; fi

HOST="${HOST_PORT%:*}"
PORT="${HOST_PORT##*:}"

mkdir -p "$(dirname "$SOCKET")"

# Run socat in its own session (process group) so the exit trap can kill the
# whole group: socat's `fork` spawns a hezo-ssh-bridge child per connection,
# and killing only the listener would leave a blocked child (e.g. stuck on a
# dead host relay) running forever. Fall back to a single-PID kill on images
# without setsid.
SETSID=""
KILL_GROUP=0
if command -v setsid >/dev/null 2>&1; then SETSID="setsid"; KILL_GROUP=1; fi
$SETSID socat "UNIX-LISTEN:$SOCKET,fork,reuseaddr,unlink-early,mode=0600,user=$SOCK_USER" \
      "EXEC:/usr/local/bin/hezo-ssh-bridge $TOKEN $HOST $PORT" &
BRIDGE_PID=$!
if [ "$KILL_GROUP" = 1 ]; then
    trap 'kill -- "-$BRIDGE_PID" 2>/dev/null' EXIT INT TERM HUP
else
    trap 'kill "$BRIDGE_PID" 2>/dev/null' EXIT INT TERM HUP
fi

i=0
while [ "$i" -lt 60 ] && [ ! -S "$SOCKET" ]; do
    sleep 0.05
    i=$((i + 1))
done

# Route apt through the per-run egress proxy. apt ignores HTTP(S)_PROXY env vars
# by design, so the proxy URL has to live in apt.conf. Written per run because
# the proxy port can change between runs.
if [ -n "${HTTPS_PROXY:-}" ]; then
    printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' \
        "$HTTPS_PROXY" "$HTTPS_PROXY" \
        | sudo tee /etc/apt/apt.conf.d/01hezo-proxy >/dev/null
fi

# Self-deadline: when the server sets HEZO_EXEC_DEADLINE_SECS (bounded ops
# like git fetch/clone), run the wrapped command under `timeout` so the whole
# tree dies on its own even if the server process is gone before the op
# finishes (crash, hard kill). Non-numeric/absent values are ignored, keeping
# old servers and new images (and vice versa) compatible.
case "${HEZO_EXEC_DEADLINE_SECS:-}" in
    ''|*[!0-9]*) ;;
    *)
        if command -v timeout >/dev/null 2>&1; then
            set -- timeout -k 5 "$HEZO_EXEC_DEADLINE_SECS" "$@"
        fi
        ;;
esac

# hezo:prompt-delivery:start
# Deliver the prompt one of three ways, chosen by HEZO_PROMPT_MODE
# (RUNTIME_PROMPT_DELIVERY in @hezo/shared):
#   arg   - the prompt's TEXT becomes a trailing argv element (Kimi Code `-p`).
#           Linux caps one argv element at 128 KiB (MAX_ARG_STRLEN), so the
#           server refuses an oversize prompt before it ever reaches here.
#   file  - the CLI opens the file itself (Grok `--prompt-file <path>`). The flag
#           AND the path are already in argv, so nothing is appended here.
#   stdin - default: the prompt file IS the CLI's stdin.
#
# Both non-stdin branches redirect stdin from /dev/null, and must: an exec's
# stdin is a pipe nothing writes to and nothing closes, and a CLI that reads it
# in headless mode hangs with no output and no exit. In both, the prompt has
# already reached the CLI another way, so stdin has nothing to carry. Same
# reasoning as PROMPT_DELIVERY_SH in agent-runner.ts, which this block mirrors -
# packages/server/test/agent-prompt-delivery.test.ts extracts the text between
# these two markers and runs it under a real `sh` against the same cases, so the
# two copies cannot drift. Keep the block self-contained.
if [ -n "${HEZO_PROMPT_FILE:-}" ] && [ -r "$HEZO_PROMPT_FILE" ]; then
    case "${HEZO_PROMPT_MODE:-stdin}" in
        arg) "$@" "$(cat "$HEZO_PROMPT_FILE")" < /dev/null ;;
        file) "$@" < /dev/null ;;
        *) "$@" < "$HEZO_PROMPT_FILE" ;;
    esac
else
    "$@"
fi
EXIT_CODE=$?
exit "$EXIT_CODE"
# hezo:prompt-delivery:end
