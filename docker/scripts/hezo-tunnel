#!/usr/bin/env node
'use strict';
/**
 * In-container end of the Hezo tunnel.
 *
 * Hezo dials *into* the container and runs this over the resulting byte
 * channel, so the Hezo instance never has to be reachable from the internet -
 * outbound to the provider is enough, and there is no tunnel credential to mint
 * or leak because the channel is already authenticated by that connection.
 *
 * What it does:
 *   - listens on three loopback ports, one per target key (proxy, mcp, ssh);
 *   - multiplexes every connection over stdin/stdout using the frame protocol;
 *   - for the proxy port, applies the split-routing policy so only hosts that
 *     need a security check reach Hezo and everything else connects direct.
 *
 * Deliberately dependency-free and CommonJS: it runs from the image's Node with
 * no install step, and must keep working when a project supplies its own
 * `docker_base_image`.
 *
 * Usage: hezo-tunnel <config.json>
 * Config: { ports: {proxy, mcp, ssh}, policy: {proxiedHosts[], proxyEverything} }
 */

const net = require('node:net');
const fs = require('node:fs');

// ---- frame protocol (mirrors services/sandbox/tunnel/protocol.ts) ----------
// Kept in sync by the round-trip test in sandbox-tunnel-client.test.ts, which
// drives this file against the server's own encoder rather than a copy of it.

const F_OPEN = 1;
const F_DATA = 2;
const F_CLOSE = 3;
const F_WINDOW = 4;
const HEADER_BYTES = 9;
const MAX_PAYLOAD_BYTES = 64 * 1024;
// Emitted once, before any frame, so Hezo can discard whatever the transport put
// on the channel ahead of us - a PTY carries the shell's echo and prompt - and so
// it knows the listeners below are bound. NUL-delimited because terminal output
// never contains NUL. Must match TUNNEL_PREAMBLE in tunnel/protocol.ts.
const TUNNEL_PROTOCOL_VERSION = 1;
const TUNNEL_PREAMBLE = Buffer.from(`\u0000HEZO-TUNNEL/${TUNNEL_PROTOCOL_VERSION}\u0000`, 'utf8');

function encodeFrame(type, streamId, payload) {
	const body = payload || Buffer.alloc(0);
	const out = Buffer.allocUnsafe(HEADER_BYTES + body.length);
	out.writeUInt8(type, 0);
	out.writeUInt32BE(streamId, 1);
	out.writeUInt32BE(body.length, 5);
	body.copy(out, HEADER_BYTES);
	return out;
}

function makeDecoder(onFrame) {
	let buffer = Buffer.alloc(0);
	return (chunk) => {
		buffer = buffer.length === 0 ? chunk : Buffer.concat([buffer, chunk]);
		for (;;) {
			if (buffer.length < HEADER_BYTES) return;
			const type = buffer.readUInt8(0);
			const streamId = buffer.readUInt32BE(1);
			const length = buffer.readUInt32BE(5);
			if (length > MAX_PAYLOAD_BYTES) throw new Error(`frame length ${length} too large`);
			const total = HEADER_BYTES + length;
			if (buffer.length < total) return;
			onFrame(type, streamId, buffer.subarray(HEADER_BYTES, total));
			buffer = buffer.subarray(total);
		}
	};
}

// ---- split routing (mirrors services/sandbox/tunnel/split-routing.ts) ------

/**
 * A leading-dot entry matches the domain and its subdomains; anything else is
 * an exact host match. Case-insensitive, since DNS is.
 */
function hostNeedsProxy(policy, host) {
	if (policy.proxyEverything) return true;
	const target = String(host).trim().toLowerCase();
	return (policy.proxiedHosts || []).some((entry) =>
		entry.startsWith('.') ? target === entry.slice(1) || target.endsWith(entry) : target === entry,
	);
}

// ---- the tunnel -----------------------------------------------------------

const config = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const policy = config.policy || { proxiedHosts: [], proxyEverything: false };

let nextStreamId = 1;
/** streamId -> { socket, credit, paused, unacked, awaitingDrain, closed } */
const streams = new Map();
let windowBytes = 256 * 1024;
let channelUp = true;

function send(type, streamId, payload) {
	if (!channelUp) return;
	process.stdout.write(encodeFrame(type, streamId, payload));
}

/** Register a socket as a tunnelled stream and start pumping it. */
function attach(socket, target) {
	const streamId = nextStreamId;
	nextStreamId += 2; // container-initiated ids are odd; Hezo never opens one.
	const stream = {
		// Starts at zero: Hezo sends the opening WINDOW once it has accepted the
		// stream, and that grant is authoritative. Seeding this with `windowBytes`
		// as well counted the same allowance twice, so the in-flight bound was
		// double what the window says - and it silently ignored a host configured
		// with a different window. Nothing stalls on the round trip: the CONNECT
		// preamble is sent regardless, and credit only decides when to *pause* the
		// socket.
		credit: 0,
		gotOpeningGrant: false,
		socket,
		paused: false,
		unacked: 0,
		awaitingDrain: false,
		closed: false,
	};
	streams.set(streamId, stream);
	send(F_OPEN, streamId, Buffer.from(target, 'utf8'));

	socket.on('data', (chunk) => {
		for (let offset = 0; offset < chunk.length; offset += MAX_PAYLOAD_BYTES) {
			const slice = chunk.subarray(offset, offset + MAX_PAYLOAD_BYTES);
			send(F_DATA, streamId, slice);
			stream.credit -= slice.length;
		}
		if (stream.credit <= 0 && !stream.paused) {
			stream.paused = true;
			socket.pause();
		}
	});
	const finish = () => {
		if (stream.closed) return;
		stream.closed = true;
		streams.delete(streamId);
		send(F_CLOSE, streamId);
	};
	socket.on('end', finish);
	socket.on('close', finish);
	socket.on('error', finish);
	socket.on('drain', () => {
		stream.awaitingDrain = false;
		flushCredit(streamId, stream);
	});
	return streamId;
}

function flushCredit(streamId, stream) {
	if (stream.awaitingDrain || stream.closed) return;
	if (stream.unacked < windowBytes / 2) return;
	const payload = Buffer.allocUnsafe(4);
	payload.writeUInt32BE(stream.unacked, 0);
	send(F_WINDOW, streamId, payload);
	stream.unacked = 0;
}

const onFrame = (type, streamId, payload) => {
	const stream = streams.get(streamId);
	if (type === F_WINDOW) {
		if (payload.length !== 4) return;
		const credit = payload.readUInt32BE(0);
		// A WINDOW for a stream we have already closed: nothing to credit.
		if (!stream) return;
		// Only the *opening* grant announces the host's window; every later one is
		// an incremental return of consumed bytes. Reading the window off those too
		// would move the half-window flush threshold around under us.
		if (!stream.gotOpeningGrant) {
			stream.gotOpeningGrant = true;
			windowBytes = credit;
		}
		stream.credit += credit;
		if (stream.paused && stream.credit > 0) {
			stream.paused = false;
			stream.socket.resume();
		}
		return;
	}
	if (!stream || stream.closed) return;
	if (type === F_DATA) {
		const accepted = stream.socket.write(payload);
		stream.unacked += payload.length;
		if (!accepted) {
			// Withhold credit until drain so Hezo stops sending rather than us
			// queueing what the local socket cannot take.
			stream.awaitingDrain = true;
			return;
		}
		flushCredit(streamId, stream);
		return;
	}
	if (type === F_CLOSE) {
		stream.closed = true;
		streams.delete(streamId);
		stream.socket.end();
	}
};

const decode = makeDecoder(onFrame);
process.stdin.on('data', (chunk) => {
	try {
		decode(chunk);
	} catch (e) {
		// A desynchronised channel cannot be recovered by parsing harder.
		process.stderr.write(`hezo-tunnel: framing error: ${e.message}\n`);
		shutdown();
	}
});

/**
 * The tunnel is the only path to Hezo, so losing it must **fail closed**.
 *
 * Every open stream is destroyed and the listeners stop accepting, so a request
 * that needed the proxy errors immediately instead of silently going direct
 * with an unsubstituted placeholder - the same posture the host-side
 * `EgressProxyUnavailableError` already takes.
 */
function shutdown() {
	channelUp = false;
	for (const stream of streams.values()) stream.socket.destroy();
	streams.clear();
	for (const server of servers) server.close();
	process.exit(0);
}
process.stdin.on('end', shutdown);
process.stdin.on('error', shutdown);

const servers = [];

/**
 * Bind one loopback listener, and make a bind failure legible.
 *
 * Without an `error` handler a failed `listen` is an uncaught exception: the
 * client dies, the channel ends, and the run fails with a dead stream and no
 * cause. EADDRINUSE is the realistic one - an agent may already have bound a
 * port in this range while developing - and stderr is surfaced by the host.
 */
function listen(port, onConnection) {
	const server = net.createServer(onConnection);
	server.on('error', (e) => {
		process.stderr.write(`hezo-tunnel: cannot listen on 127.0.0.1:${port}: ${e.message}\n`);
		shutdown();
	});
	server.listen(port, '127.0.0.1');
	servers.push(server);
	return server;
}

/** The MCP and SSH ports are unconditionally tunnelled - there is no direct route to Hezo. */
for (const target of ['mcp', 'ssh']) {
	const port = config.ports[target];
	if (!port) continue;
	listen(port, (socket) => attach(socket, target));
}

/**
 * The proxy port speaks HTTP CONNECT itself, so it can decide per host whether
 * to hand the connection to Hezo or dial out directly.
 *
 * Reading only the CONNECT line means the client's own TLS is untouched - this
 * never terminates it, so nothing here can see a request body either way.
 */
if (config.ports.proxy) {
	listen(config.ports.proxy, (socket) => {
		let head = Buffer.alloc(0);
		const onHead = (chunk) => {
			head = Buffer.concat([head, chunk]);
			const end = head.indexOf('\r\n\r\n');
			// Bound the preamble so a client that never sends one cannot grow it.
			if (end === -1) {
				if (head.length > 16 * 1024) socket.destroy();
				return;
			}
			socket.removeListener('data', onHead);
			// Bytes after the preamble arrived in the same chunk and belong to the
			// tunnelled/spliced connection - dropping them loses the first request
			// on any client that pipelines, which is most of them.
			const rest = head.subarray(end + 4);
			const preamble = head.subarray(0, end + 4);
			const requestLine = head.subarray(0, head.indexOf('\r\n')).toString('utf8');
			const match = /^CONNECT\s+([^\s:]+)(?::(\d+))?/i.exec(requestLine);
			if (!match) {
				// A plain (non-CONNECT) proxy request carries the whole request in
				// the clear; hand it to Hezo, which is the only thing that can
				// decide what to do with it.
				send(F_DATA, attach(socket, 'proxy'), head);
				return;
			}
			const host = match[1];
			const port = Number(match[2] || 443);

			if (hostNeedsProxy(policy, host)) {
				if (!channelUp) {
					// Fail closed: never fall back to direct for a host whose
					// requests may carry a placeholder Hezo has to substitute.
					socket.end('HTTP/1.1 502 Bad Gateway\r\n\r\n');
					return;
				}
				const id = attach(socket, 'proxy');
				send(F_DATA, id, preamble);
				if (rest.length > 0) send(F_DATA, id, rest);
				return;
			}

			// Direct: dial the origin ourselves and splice, so `apt`, `npm` and
			// `playwright install` never push their payload through Hezo.
			const upstream = net.connect({ host, port }, () => {
				socket.write('HTTP/1.1 200 Connection Established\r\n\r\n');
				if (rest.length > 0) upstream.write(rest);
				socket.pipe(upstream);
				upstream.pipe(socket);
			});
			upstream.on('error', () => {
				socket.end('HTTP/1.1 502 Bad Gateway\r\n\r\n');
			});
			socket.on('error', () => upstream.destroy());
		};
		socket.on('data', onHead);
		socket.on('error', () => socket.destroy());
	});
}

/**
 * Announce ourselves, last of all.
 *
 * Everything before this on the channel is whatever the transport put there - a
 * PTY carries the shell's echo of the command that started us, its
 * bracketed-paste escapes and its prompt - and Hezo discards all of it up to
 * this marker.
 *
 * Emitted after the listeners are bound so it cannot precede a working tunnel,
 * but the host does not treat it as the readiness signal: it probes the
 * listening sockets directly instead, which is the fact rather than a proxy for
 * it. See `waitForTunnelListeners` in `tunnel/run-tunnel.ts`.
 */
process.stdout.write(TUNNEL_PREAMBLE);
