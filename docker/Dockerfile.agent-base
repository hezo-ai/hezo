FROM node:24-slim

# Install common development tools. `unzip` is required by the upstream bun.sh
# installer and other `curl | bash` installers agents may run at runtime.
# `file`, `imagemagick`, and `python3-pip` cover the image-inspection and
# scripting tasks agents routinely hit (e.g. checking a delivered asset's
# dimensions) without a runtime `sudo apt-get install`.
#
# `p7zip-full` covers `.7z`, which humans can attach to a task but which has no
# extractor in the base image (`tar` and `gzip` are Essential-priority Debian
# packages and `unzip` is installed above, so the other attachable archive
# formats already work). `.rar` is deliberately left out: `unrar-free` handles
# only part of the format and full RAR5 support is non-free, so an agent that
# actually meets one installs an extractor at runtime.
#
# Debian's packaged `git` is sufficient: every git operation (worktree add,
# status, commit, push) runs inside this container via `docker exec`, and the
# per-task worktrees are created and consumed entirely with in-container paths,
# so nothing depends on the relative-path worktree extension (`extensions.
# relativeWorktrees`, git 2.48+) — no code passes `--relative-paths`. That is why
# building git from source is no longer needed; the distro package keeps the
# image build fast and cache-friendly.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl jq unzip p7zip-full openssh-client ca-certificates python3 python3-pip file imagemagick socat sudo iproute2 \
    && rm -rf /var/lib/apt/lists/*

# The container runs as the unprivileged `node` user (so bind-mounted worktree
# files stay node-owned), but agents need to install system packages at runtime
# (e.g. `npx playwright install-deps`). Grant passwordless sudo: the container is
# an ephemeral, egress-constrained sandbox in which the agent already executes
# arbitrary code, so in-container root does not widen the trust boundary.
RUN echo 'node ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/node \
    && chmod 0440 /etc/sudoers.d/node

ENV PATH="/root/.local/bin:${PATH}"

# Install AI coding CLIs
#   @anthropic-ai/claude-code → claude (also drives DeepSeek, Z.ai, and the `kimi`
#                                       provider via their Anthropic-compatible
#                                       endpoints)
#   @openai/codex             → codex
#   opencode-ai               → opencode
#
# Every CLI is pinned. These float otherwise, and a floating CLI changes the
# behaviour of a run with no commit, no review and no signal: Codex v0.116.0
# changed how it sanitizes MCP tool names (hyphens became underscores) and the
# change simply arrived mid-flight, breaking the tool names agents were told to
# look for. Pinning is not upgrading - each version below is what `latest`
# resolved to when the pin landed, so this froze the status quo rather than
# moving it.
#
# A bump is a deliberate act: re-verify that runtime's stream parsing, hook
# contract and config keys still hold before changing a number here.
# `.github/workflows/cli-drift.yml` reports what has fallen behind so a pin
# cannot rot unnoticed. `agent-cli-pins.test.ts` fails the suite if an install
# here loses its pin.
ARG CLAUDE_CODE_VERSION=2.1.238
ARG CODEX_VERSION=0.149.0
ARG OPENCODE_VERSION=1.18.20
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && npm install -g @openai/codex@${CODEX_VERSION} \
    && npm install -g opencode-ai@${OPENCODE_VERSION} \
    && claude --version \
    && codex --version \
    && opencode --version

# Google Antigravity CLI (`agy`) - drives the `google` provider (API-key only in
# Hezo for now; Antigravity's consumer subscription can't yet be delivered into a
# per-run container). A native binary from an
# installer, not npm; its default install dir is $HOME/.local/bin (root's during
# build), so install to the shared PATH like Grok so the non-root `node` run-user
# can execute it. At run time agy reads its config from the run-user's own
# `$HOME/.gemini`, written per run by the antigravity adapter.
#
# Pinned by artifact URL + checksum rather than by version, because the upstream
# installer offers no way to choose one: it accepts only `-d` and `-h`, and the
# manifest it reads (`/manifests/linux_amd64.json`) exposes the current release
# only. The artifact path carries an opaque build id after the version
# (`.../1.1.17-5084709148033024/...`), so it cannot be rebuilt from AGY_VERSION
# alone - the full URL has to be recorded.
#
# To bump: fetch
# https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json
# and copy `version`, `url` and `sha512` across. The `agy --version` check below
# compares against AGY_VERSION, so a URL and a version that disagree fail the
# build instead of shipping a mislabelled binary.
ARG AGY_VERSION=1.1.17
ARG AGY_URL=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.1.17-5084709148033024/linux-x64/cli_linux_x64.tar.gz
ARG AGY_SHA512=5c6047a19e80025ea7cecc8152fb263a7f14e80591ee75bdf1ca10191cc0cd1639b5b5ebdce4d1c9d43b14bd2446f038a457821694579f4392b6ca9736512936
# The archive holds a single member named `antigravity`; upstream's installer
# renames it to `agy` on the way in, and then hands off to `agy install --dir`
# for its own shell setup. Both steps are reproduced here so replacing the
# installer changes only WHICH build lands, not what the image ends up with.
# `agy install` is tolerant by design (upstream absorbs its exit), so it must not
# fail the build.
RUN curl -fsSL "${AGY_URL}" -o /tmp/agy.tar.gz \
    && echo "${AGY_SHA512}  /tmp/agy.tar.gz" | sha512sum -c - \
    && tar -xzf /tmp/agy.tar.gz -C /tmp antigravity \
    && install -m 0755 /tmp/antigravity /usr/local/bin/agy \
    && rm -f /tmp/agy.tar.gz /tmp/antigravity \
    && (agy install --dir /usr/local/bin || true) \
    && agy --version \
    && agy --version | grep -q "${AGY_VERSION}"

# Moonshot Kimi Code (`kimi`) — the `kimi` provider's native-CLI option, alongside
# (not instead of) its default Claude Code path above. Pinned
# for reproducibility like GROK_VERSION: upstream ships two engine generations
# with duplicated MCP/hook/media paths, so a bump must be re-verified against the
# stream-json line shapes, the `[[hooks]]` Stop contract, and the session-log
# usage fields (see `extractKimiUsageFromSessionLog`). Requires Node >= 22.19,
# which the node:24 base satisfies; `kimi --version` fails the build if not.
# At run time KIMI_CODE_HOME is overridden per-run to the agent's config dir.
ARG KIMI_CODE_VERSION=0.30.0
RUN npm install -g @moonshot-ai/kimi-code@${KIMI_CODE_VERSION} \
    && kimi --version

# xAI Grok Build (`grok`) — a standalone static binary (no npm). The installer
# downloads to $HOME/.grok/downloads and symlinks GROK_BIN_DIR; install under a
# world-readable /opt with the symlink on the shared PATH so the non-root `node`
# run-user can execute it. Pinned for reproducibility — bump GROK_VERSION to
# upgrade (re-verify `grok --help`/config/debug-span format on a bump). At
# run-time GROK_HOME is overridden per-run to the agent's config dir.
ARG GROK_VERSION=0.2.93
RUN HOME=/opt GROK_BIN_DIR=/usr/local/bin bash -c \
      "curl -fsSL https://x.ai/cli/install.sh | bash -s ${GROK_VERSION}" \
    && chmod -R a+rX /opt/.grok \
    && grok --version

# Pre-install Bun for agent-authored JS/TS projects — the common case, and the
# runtime Hezo itself uses. Installed globally via npm so `bun`/`bunx` land on the
# shared PATH for both root and the `node` user (matching the AI CLIs above). The
# trailing `bun --version` fails the build if the install is broken.
#
# This is the CONTAINER's bun, for code agents write. It is independent of
# `BUN_VERSION` in `.github/workflows/ci.yml`, which pins the Bun that builds and
# runs Hezo itself; the two can and will diverge, and neither constrains the
# other.
ARG BUN_VERSION=1.4.0
RUN npm install -g bun@${BUN_VERSION} \
    && bun --version

# SSH agent bridge: in-container Unix socket relayed to host TCP. Used so
# the same wire-up runs on macOS Docker Desktop (which does not forward
# AF_UNIX bind mounts) and Linux production with no platform branching.
COPY scripts/hezo-ssh-bridge /usr/local/bin/hezo-ssh-bridge
COPY scripts/hezo-run-with-bridge /usr/local/bin/hezo-run-with-bridge
# Tunnel client: multiplexes the container's connections to Hezo over the byte
# channel Hezo dials in on, so the instance needs no inbound reachability.
COPY scripts/hezo-tunnel /usr/local/bin/hezo-tunnel
RUN chmod +x /usr/local/bin/hezo-ssh-bridge /usr/local/bin/hezo-run-with-bridge \
    /usr/local/bin/hezo-tunnel

# Runtime dir for the per-run Unix socket. The container is started as the
# unprivileged `node` user, which cannot create subdirectories under /run.
RUN mkdir -p /run/hezo && chown node:node /run/hezo

# No GitHub host-key pin here any more. Git transport is HTTPS on every backend
# (see `buildGitRemoteUrl`), so there is no SSH connection to GitHub to verify -
# the pin was guarding a transport nothing uses, and a stale entry after a GitHub
# key rotation would have become a silent breakage. SSH remains for commit
# signing, which is local and contacts no host.

WORKDIR /workspace
